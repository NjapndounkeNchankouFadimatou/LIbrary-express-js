// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model users {
  user_id       String @id @default(uuid()) @map("_id")
  name     String
  email    String @unique
  password String


  //relations 
  loans loan[]
  notifications notification[]
  books library[]
}

model library {
  Lib_id          String @id @default(uuid()) @map("_id")
  title       String
  author      String
  description String
  publishDate   DateTime @default(now())
  ISBN        String

  //relation
  booksId  String
  library users @relation(fields: [booksId] , references: [user_id] ,onDelete : Cascade )

  loans loan[]
  books notification[]
}

model loan {
  loan_id         String @id @default(uuid()) @map("_id")
  loanDate   DateTime @default(now())
  returnDate  DateTime @default(now())

  //relations
  notifications notification[]

  userId  String
  user users @relation(fields: [userId] , references: [user_id]  , onDelete : Cascade)
  booksId  String
  library library @relation(fields: [booksId] , references: [Lib_id] ,onDelete : Cascade )


}

model notification {
  id      String @id @default(uuid()) @map("_id")
  message String

  //relations 
  userId  String
  user users @relation(fields: [userId] , references: [user_id] , onDelete : Cascade)

  libraryId  String
  library library @relation(fields: [libraryId] , references: [Lib_id] , onDelete : Cascade)

  loanId   String
  loan loan @relation(fields: [loanId] , references: [loan_id] ,onDelete : Cascade )

}
